# Скопируйте файл в .env.local. Секреты не добавляются в Git.

NODE_ENV=development
PORT=4444
DATABASE_URL=postgresql://mailing:mailing@localhost:5432/mailing?schema=public

# mock позволяет запускать API без Telegram-токена и используется по умолчанию.
TELEGRAM_MODE=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org

# Если значение задано, API требует заголовок X-API-Key на защищённых маршрутах.
API_KEY=

QUEUE_DELAY_MS=750
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=1000
CORS_ORIGINS=http://localhost:3000,http://localhost:4444
