{
    "name": "qrver-telegram-mailing-service",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsx watch src/index.ts",
        "format": "prettier --write .",
        "start": "node dist/index.js",
        "test": "node --import tsx --test test/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy"
    },
    "author": "qrver",
    "license": "SEE LICENSE",
    "description": "Самостоятельный API-сервис управления Telegram-рассылками.",
    "dependencies": {
        "@prisma/client": "^6.12.0",
        "cors": "^2.8.5",
        "dotenv": "^17.0.0",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.1",
        "helmet": "^8.1.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^22.15.0",
        "@types/swagger-ui-express": "^4.1.8",
        "playwright": "^1.62.1",
        "prettier": "^3.6.2",
        "prisma": "^6.12.0",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3"
    }
}
